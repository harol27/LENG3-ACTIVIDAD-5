@model proyectofinal.Models.Empleado

@{
    ViewData["Title"] = "Detalles del Empleado";
}

<h1>Detalles del Empleado</h1>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Departamento</dt>
    <dd class="col-sm-10">@Model.Departamento?.Nombre</dd>

    <dt class="col-sm-2">Cargo</dt>
    <dd class="col-sm-10">@Model.Cargo?.Nombre</dd>

    <dt class="col-sm-2">Fecha Inicio</dt>
    <dd class="col-sm-10">@Model.FechaInicio.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-2">Salario</dt>
    <dd class="col-sm-10">@Model.Salario</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@(Model.Vigente ? "Vigente" : "No vigente")</dd>

    <dt class="col-sm-2">Tiempo en empresa</dt>
    <dd class="col-sm-10">@Model.TiempoEnEmpresa</dd>

    <dt class="col-sm-2">AFP</dt>
    <dd class="col-sm-10">@Model.AFP</dd>

    <dt class="col-sm-2">ARS</dt>
    <dd class="col-sm-10">@Model.ARS</dd>

    <dt class="col-sm-2">ISR</dt>
    <dd class="col-sm-10">@Model.ISR</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
