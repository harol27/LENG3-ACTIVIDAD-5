@model IEnumerable<proyectofinal.Models.Empleado>

<h1>Empleados</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar Empleado</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Departamento</th>
            <th>Cargo</th>
            <th>Salario</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Departamento?.Nombre</td>
                <td>@item.Cargo?.Nombre</td>
                <td>@item.Salario</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
