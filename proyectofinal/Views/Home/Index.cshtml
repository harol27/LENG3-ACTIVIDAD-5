@{
    ViewData["Title"] = "Menú Principal";
}

<div class="container mt-5">

    <h1 class="text-center mb-4" style="font-size: 3rem; font-weight: 700; color: #2c3e50;">
        Sistema de Manejo de Empleados
    </h1>

    <p class="text-center mb-5" style="font-size: 1.3rem; color: #34495e;">
        Selecciona una opción del menú para comenzar
    </p>

    <div class="row justify-content-center">

        
        <div class="col-md-3 mb-4">
            <a asp-controller="Empleados" asp-action="Index" class="menu-card">
                <div class="card shadow-lg text-center p-4 menu-hover">
                    <i class="bi bi-people-fill" style="font-size: 3rem; color: #3498db;"></i>
                    <h4 class="mt-3">Empleados</h4>
                    <p>Gestionar empleados</p>
                </div>
            </a>
        </div>

      
        <div class="col-md-3 mb-4">
            <a asp-controller="Departamentos" asp-action="Index" class="menu-card">
                <div class="card shadow-lg text-center p-4 menu-hover">
                    <i class="bi bi-building" style="font-size: 3rem; color: #27ae60;"></i>
                    <h4 class="mt-3">Departamentos</h4>
                    <p>Administrar departamentos</p>
                </div>
            </a>
        </div>

      
        <div class="col-md-3 mb-4">
            <a asp-controller="Cargos" asp-action="Index" class="menu-card">
                <div class="card shadow-lg text-center p-4 menu-hover">
                    <i class="bi bi-person-badge-fill" style="font-size: 3rem; color: #e67e22;"></i>
                    <h4 class="mt-3">Cargos</h4>
                    <p>Administrar cargos</p>
                </div>
            </a>
        </div>

    </div>
</div>

<style>
    .menu-card {
        text-decoration: none;
        color: inherit;
    }

    .menu-hover:hover {
        transform: scale(1.05);
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

    .menu-card .card {
        border-radius: 15px;
    }
</style>
