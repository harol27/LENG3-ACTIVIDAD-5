@model proyectofinal.Models.Departamento

@{
    ViewData["Title"] = "Eliminar Departamento";
}

<h1 class="mb-4 text-danger">Eliminar Departamento</h1>

<h4>¿Seguro que deseas eliminar este departamento?</h4>

<div class="border p-3 col-md-6">
    <dl class="row">
        <dt class="col-sm-3">ID:</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Nombre:</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
    </dl>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
